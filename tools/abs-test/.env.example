# Copy to .env and fill in. .env is git-ignored and must stay that way:
# nothing in here belongs in a commit, a log, or the app's database.
#
#   cp .env.example .env
#
# Pick your own passwords. They guard a disposable container on localhost,
# so they need to be unique rather than strong — never reuse a real one.

# Where the test server answers. Matches the port in docker-compose.yml.
ABS_URL=http://localhost:13378

# The root account. seed.sh creates it on a fresh server via POST /init and
# uses it for setup only; nothing after setup is allowed to run as admin.
ABS_ADMIN_USER=root
ABS_ADMIN_PASS=

# The normal account with download permission ON. Everything in verify.sh
# runs as this user, because this is what the app will be.
ABS_TEST_USER=dueback-test
ABS_TEST_PASS=

# The normal account with download permission OFF, for proving the client
# handles a server that refuses to hand over files.
ABS_NODL_USER=dueback-nodl
ABS_NODL_PASS=

# Optional: where ffmpeg lives, if it is not on PATH. seed.sh needs it to
# generate the test audio; verify.sh does not.
#FFMPEG=C:/Users/you/ffmpeg/bin/ffmpeg.exe
