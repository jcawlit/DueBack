{
  "expo": {
    "name": "Due Back",
    "slug": "dueback",
    "scheme": "dueback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1b1410",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dueback.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.dueback.app",
      "//usesCleartextTraffic": "DEV-STAGE, must be scoped before release. An Audiobookshelf server on the LAN is reached over plain http, and Android blocks cleartext by default, so a connect attempt fails at the socket with no useful error. This opens it for the whole app, which is more than release should ship: the release version is a network security config that permits cleartext only for private address ranges. Tracked in docs/STATE.md.",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1b1410",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#120d0a"
        }
      ],
      "expo-sqlite",
      "./plugins/withBackupExclusion",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
